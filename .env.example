# Control Galpones La Calera
# Configuracion automatica para Google AI Studio y Cloud Run.
# En entorno web todas las llamadas al servidor utilizan rutas relativas /api/* en el mismo origen.
# La configuracion de Firebase se lee directamente desde firebase-applet-config.json.
# Variables opcionales de desarrollo sintético. Definir las del servidor en su proceso.
# CALERA_DEMO_PROJECT=demo-calera-phase11
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# VITE_CALERA_DEMO_PROJECT=demo-calera-phase11
# VITE_CALERA_AUTH_EMULATOR=http://127.0.0.1:9099
# Vigencia máxima del acceso operativo sin verificar la sesión (15 a 1440 minutos).
# VITE_OFFLINE_AUTH_MINUTES=480
# Compilación posterior para Capacitor.
# VITE_API_BASE_URL=https://api.example.test
# Origenes adicionales de la API, separados por comas. La web usa su mismo origen.
# CALERA_ALLOWED_ORIGINS=https://web.example.test,capacitor://localhost
