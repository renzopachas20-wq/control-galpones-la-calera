{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil de usuario y rol de acceso en Control Galpones La Calera",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID del usuario"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Correo electrónico corporativo o de acceso"
        },
        "displayName": {
          "type": "string",
          "description": "Nombre completo del usuario"
        },
        "dni": {
          "type": "string",
          "description": "Documento Nacional de Identidad del usuario"
        },
        "authMethod": {
          "type": "string",
          "enum": [
            "password",
            "google",
            "both"
          ],
          "description": "Método de autenticación habilitado para el usuario"
        },
        "role": {
          "type": "string",
          "enum": [
            "Administrador",
            "Jefe de proyecto",
            "Supervisor",
            "Auxiliar",
            "Almacén",
            "Solo lectura"
          ],
          "description": "Rol oficial asignado dentro de la matriz de permisos"
        },
        "active": {
          "type": "boolean",
          "description": "Indica si el usuario tiene acceso activo al sistema"
        },
        "assignedProject": {
          "type": "string",
          "description": "Código o nombre del proyecto asignado (o TODOS para acceso global)"
        },
        "assignedSectorIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs de sectores asignados al usuario"
        },
        "assignedGalponIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs de galpones asignados al usuario"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de creación del perfil"
        },
        "createdBy": {
          "type": "string",
          "description": "UID del administrador que creó el usuario"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de última modificación del perfil"
        },
        "updatedBy": {
          "type": "string",
          "description": "UID del último usuario que actualizó el perfil"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha y hora del último inicio de sesión exitoso"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "role",
        "active",
        "assignedSectorIds",
        "assignedGalponIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProviderConfig": {
      "title": "ProviderConfig",
      "description": "Proveedor tecnológico o constructivo (ej. ZUCAMI, TECNO, PROPIO)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador del proveedor"
        },
        "name": {
          "type": "string",
          "description": "Nombre del proveedor/tecnología"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de última actualización"
        },
        "updatedBy": {
          "type": "string",
          "description": "UID del usuario que actualizó el proveedor"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "CatalogItem": {
      "title": "CatalogItem",
      "description": "Ítem o actividad del Catálogo Maestro constructivo por proveedor",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único de la plantilla de actividad"
        },
        "code": {
          "type": "string",
          "description": "Código del ítem en catálogo"
        },
        "name": {
          "type": "string",
          "description": "Nombre de la partida o actividad"
        },
        "category": {
          "type": "string",
          "description": "Fase o categoría constructiva"
        },
        "technology": {
          "type": "string",
          "description": "Tecnología o proveedor (ZUCAMI, TECNO, PROPIO, etc.)"
        },
        "unit": {
          "type": "string",
          "description": "Unidad de medida"
        },
        "defaultQuantity": {
          "type": "number",
          "description": "Meta base por defecto"
        },
        "defaultDays": {
          "type": "number",
          "description": "Duración estimada en días"
        },
        "weight": {
          "type": "number",
          "description": "Peso relativo o ponderación"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de última actualización"
        },
        "updatedBy": {
          "type": "string",
          "description": "UID del usuario que modificó el registro"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "technology",
        "unit"
      ]
    },
    "Sector": {
      "title": "Sector",
      "description": "Sector operativo de La Calera con su lista de galpones y cronograma de actividades",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID único del sector"
        },
        "name": {
          "type": "string",
          "description": "Nombre del sector"
        },
        "sheds": {
          "type": "array",
          "description": "Lista de galpones pertenecientes al sector con sus actividades y estado"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de última modificación"
        },
        "updatedBy": {
          "type": "string",
          "description": "UID del usuario que realizó la modificación"
        }
      },
      "required": [
        "id",
        "name",
        "sheds"
      ]
    },
    "Material": {
      "title": "Material",
      "description": "Registro de material en almacén por galpón",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID único del material (materialId)"
        },
        "code": {
          "type": "string",
          "description": "Código de material"
        },
        "name": {
          "type": "string",
          "description": "Descripción del material"
        },
        "category": {
          "type": "string",
          "description": "Categoría de material"
        },
        "unit": {
          "type": "string",
          "description": "Unidad de medida"
        },
        "totalQty": {
          "type": "number",
          "description": "Cantidad presupuestada/requerida"
        },
        "receivedQty": {
          "type": "number",
          "description": "Cantidad ingresada a almacén"
        },
        "usedQty": {
          "type": "number",
          "description": "Cantidad consumida acumulada"
        },
        "minStock": {
          "type": "number",
          "description": "Stock mínimo de alerta"
        },
        "shedId": {
          "type": "string",
          "description": "ID del galpón asignado"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de última actualización"
        },
        "updatedBy": {
          "type": "string",
          "description": "UID del usuario que actualizó el material"
        }
      },
      "required": [
        "id",
        "name",
        "unit",
        "totalQty",
        "receivedQty",
        "usedQty",
        "shedId"
      ]
    },
    "DailyAdvance": {
      "title": "DailyAdvance",
      "description": "Parte diario de avance físico, mano de obra y materiales utilizados",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID único del registro de avance"
        },
        "date": {
          "type": "string",
          "description": "Fecha del parte diario (YYYY-MM-DD)"
        },
        "sectorId": {
          "type": "string",
          "description": "ID del sector"
        },
        "shedId": {
          "type": "string",
          "description": "ID del galpón"
        },
        "taskId": {
          "type": "string",
          "description": "ID de la actividad/tarea"
        },
        "quantity": {
          "type": "number",
          "description": "Cantidad física ejecutada en el día"
        },
        "workers": {
          "type": "number",
          "description": "Número total de trabajadores en la cuadrilla"
        },
        "responsible": {
          "type": "string",
          "description": "Nombre del responsable del parte"
        },
        "comments": {
          "type": "string",
          "description": "Observaciones del trabajo ejecutado"
        },
        "workerDetails": {
          "type": "array",
          "description": "Detalle nominal de trabajadores asignados"
        },
        "materialsUsed": {
          "type": "array",
          "description": "Lista de materiales consumidos con materialId y qty"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de última actualización"
        },
        "updatedBy": {
          "type": "string",
          "description": "UID del usuario que registró o modificó el avance"
        }
      },
      "required": [
        "id",
        "date",
        "sectorId",
        "shedId",
        "taskId",
        "quantity"
      ]
    },
    "Worker": {
      "title": "Worker",
      "description": "Trabajador registrado en la Planilla Maestra de Personal",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID único del trabajador"
        },
        "code": {
          "type": "string",
          "description": "Código o DNI del trabajador"
        },
        "name": {
          "type": "string",
          "description": "Apellidos y nombres completos"
        },
        "role": {
          "type": "string",
          "description": "Cargo u ocupación"
        },
        "specialty": {
          "type": "string",
          "description": "Especialidad técnica"
        },
        "Category": {
          "type": "string",
          "description": "Categoría laboral (Operario, Oficial, Peón, etc.)"
        },
        "phone": {
          "type": "string",
          "description": "Teléfono de contacto"
        },
        "status": {
          "type": "string",
          "description": "Estado del trabajador (Activo, Inactivo, etc.)"
        },
        "assignedShedId": {
          "type": "string",
          "description": "ID del galpón asignado"
        },
        "entryDate": {
          "type": "string",
          "description": "Fecha de ingreso"
        },
        "dailyRate": {
          "type": "number",
          "description": "Jornal diario referencial"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de última actualización"
        },
        "updatedBy": {
          "type": "string",
          "description": "UID del usuario que modificó el registro"
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "status"
      ]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Registro diario de asistencia de personal por fecha",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Fecha del registro (YYYY-MM-DD) usada como ID del documento"
        },
        "date": {
          "type": "string",
          "description": "Fecha en formato YYYY-MM-DD"
        },
        "records": {
          "type": "object",
          "description": "Mapa de workerId -> estado de asistencia (A, F, T, P, D)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de última modificación"
        },
        "updatedBy": {
          "type": "string",
          "description": "UID del usuario que registró la asistencia"
        }
      },
      "required": [
        "id",
        "date",
        "records"
      ]
    },
    "MovementLog": {
      "title": "MovementLog",
      "description": "Registro inmutable de auditoría e historial de movimientos del sistema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID único del movimiento"
        },
        "timestamp": {
          "type": "string",
          "description": "Fecha y hora formateada legible"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp ISO 8601 exacto"
        },
        "user": {
          "type": "string",
          "description": "Nombre y rol del usuario que ejecutó la acción"
        },
        "userId": {
          "type": "string",
          "description": "UID de Firebase Auth del autor"
        },
        "userEmail": {
          "type": "string",
          "description": "Correo electrónico del autor"
        },
        "userRole": {
          "type": "string",
          "description": "Rol oficial del autor al momento de la operación"
        },
        "type": {
          "type": "string",
          "enum": [
            "REGISTRO",
            "MODIFICACIÓN",
            "ELIMINACIÓN"
          ],
          "description": "Tipo de operación auditada"
        },
        "module": {
          "type": "string",
          "description": "Módulo funcional donde ocurrió el cambio"
        },
        "targetId": {
          "type": "string",
          "description": "Identificador del registro afectado"
        },
        "detail": {
          "type": "string",
          "description": "Descripción detallada de la acción"
        },
        "previousValue": {
          "type": "string",
          "description": "Resumen o JSON del valor anterior (si aplica)"
        },
        "newValue": {
          "type": "string",
          "description": "Resumen o JSON del valor nuevo (si aplica)"
        }
      },
      "required": [
        "id",
        "timestamp",
        "user",
        "userId",
        "type",
        "module",
        "detail"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Perfiles de usuario y roles del sistema"
    },
    "/providers/{providerId}": {
      "schema": {
        "$ref": "#/entities/ProviderConfig"
      },
      "description": "Proveedores constructivos habilitados"
    },
    "/masterCatalog/{itemId}": {
      "schema": {
        "$ref": "#/entities/CatalogItem"
      },
      "description": "Catálogo maestro de actividades constructivas por tecnología"
    },
    "/sectors/{sectorId}": {
      "schema": {
        "$ref": "#/entities/Sector"
      },
      "description": "Sectores operativos con sus galpones y cronogramas de tareas"
    },
    "/materials/{materialId}": {
      "schema": {
        "$ref": "#/entities/Material"
      },
      "description": "Inventario y control de materiales por galpón"
    },
    "/advances/{advanceId}": {
      "schema": {
        "$ref": "#/entities/DailyAdvance"
      },
      "description": "Registros diarios de avance físico, personal y consumo de materiales"
    },
    "/workers/{workerId}": {
      "schema": {
        "$ref": "#/entities/Worker"
      },
      "description": "Planilla maestra de personal y asignación por galpón"
    },
    "/attendance/{attendanceId}": {
      "schema": {
        "$ref": "#/entities/AttendanceRecord"
      },
      "description": "Control diario de asistencia de personal"
    },
    "/movements/{movementId}": {
      "schema": {
        "$ref": "#/entities/MovementLog"
      },
      "description": "Bitácora inmutable de auditoría e historial de movimientos"
    }
  }
}
