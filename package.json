{
  "name": "gestion-galpones-la-calera",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:isolated": "node scripts/build-isolated.mjs",
    "lint": "tsc --noEmit",
    "lint:rules": "eslint firestore.rules",
    "test": "node scripts/test.mjs",
    "test:security": "node --import tsx --test server/auth.test.ts",
    "test:security:emulator": "node --import tsx --test server/auth.emulator.test.ts",
    "test:browser": "node --import tsx scripts/browser-acceptance.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google-cloud/firestore": "9.4.0",
    "@types/express": "^5.0.6",
    "eslint": "^10.14.0",
    "express": "^5.3.0",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
